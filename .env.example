TZ=America/Sao_Paulo

# id -u / id -g do usuário do host (dono dos arquivos baixados)
PUID=501
PGID=20

# Pasta de trabalho dos downloads de torrent (caminho absoluto, o mesmo no host e no qBittorrent).
# Ao terminar, o akari move os arquivos para o storage provider da preferência torrent.library-provider-id.
TORRENT_DOWNLOAD_DIR=/caminho/absoluto/da/pasta-de-downloads

# Chave WireGuard do ProtonVPN, gerada com apenas o NAT-PMP habilitado
WIREGUARD_PRIVATE_KEY=

SERVER_COUNTRIES=Netherlands
SERVER_CITIES=
SERVER_HOSTNAMES=

# Chave aleatória (openssl rand -base64 16); a mesma vai em gluetun/config.toml
GSP_GTN_API_KEY=

# Login da WebUI do qBittorrent usado pelo akari (admin/admin vem na config inicial da imagem)
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=admin
