# =========================================================
# Imagem de DESENVOLVIMENTO
# Quarkus Dev Mode: hot reload (live coding) + debug remoto
# =========================================================

# JDK 25 completo + wrapper Maven (necessário para compilar em runtime)
FROM registry.access.redhat.com/ubi10/openjdk-25:1.24-14

# Diretório onde o código-fonte é montado via volume (ver docker-compose.dev.yml)
USER 0

# 'unzip' é exigido pelo Maven Wrapper: sem ele o wrapper baixa o .tar.gz
# em vez do .zip e a validação do distributionSha256Sum falha.
RUN microdnf install -y unzip
RUN microdnf clean all

RUN mkdir -p /workspace
RUN chown 185:0 /workspace

WORKDIR /workspace

# Usuário sem privilégios (HOME=/home/default, com ~/.m2 gravável)
USER 185

# Pré-carrega as dependências na imagem para acelerar o primeiro start.
# Como só copiamos wrapper + pom, esta camada é cacheada enquanto o pom não muda.
COPY --chown=185:0 .mvn/ .mvn/
COPY --chown=185:0 mvnw pom.xml ./

RUN chmod +x mvnw
RUN ./mvnw -B dependency:go-offline

# 8080: HTTP  |  5005: debug remoto da JVM (JDWP)
EXPOSE 8080 5005

# Sobe em dev mode:
#  - hot reload das alterações no código montado em /wor1kspace
#  - servidor de debug escutando em 0.0.0.0:5005 (suspend=n)
ENTRYPOINT ["./mvnw", "quarkus:dev", \
    "-Dquarkus.http.host=0.0.0.0", \
    "-Ddebug=5005", \
    "-DdebugHost=0.0.0.0", \
    "-Dquarkus.analytics.disabled=true"]
